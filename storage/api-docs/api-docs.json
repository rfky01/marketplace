{
    "openapi": "3.0.0",
    "info": {
        "title": "Dokumentasi API Marketplace",
        "description": "Dokumentasi lengkap untuk API Marketplace Magang",
        "contact": {
            "email": "admin@marketplace.com"
        },
        "version": "1.0.0"
    },
    "paths": {
        "/api/register": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Register User Baru",
                "operationId": "8a56853624e025573120a09a4c75d468",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "name",
                                    "email",
                                    "password",
                                    "role"
                                ],
                                "properties": {
                                    "name": {
                                        "type": "string",
                                        "example": "Budi Pembeli"
                                    },
                                    "email": {
                                        "type": "string",
                                        "format": "email",
                                        "example": "budi@gmail.com"
                                    },
                                    "password": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "password123"
                                    },
                                    "role": {
                                        "description": "Pilih: buyer atau seller",
                                        "type": "string",
                                        "example": "buyer"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Berhasil Register"
                    }
                }
            }
        },
        "/api/login": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Login User (Seller/Buyer/Admin)",
                "description": "Masukkan email dan password untuk mendapatkan Token",
                "operationId": "a3b306d14572d1f4bd6c064b3233e7b8",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "email",
                                    "password"
                                ],
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "format": "email",
                                        "example": "seller@example.com"
                                    },
                                    "password": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "password"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Berhasil Login",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "access_token": {
                                            "type": "string",
                                            "example": "eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9..."
                                        },
                                        "token_type": {
                                            "type": "string",
                                            "example": "Bearer"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Email atau Password Salah"
                    }
                }
            }
        },
        "/api/send-otp": {
            "post": {
                "tags": [
                    "Otentikasi"
                ],
                "summary": "Kirim OTP WhatsApp",
                "description": "Mengirim kode OTP ke nomor WhatsApp user sebelum registrasi",
                "operationId": "sendOtp",
                "requestBody": {
                    "description": "Data nomor HP yang akan dikirimkan OTP",
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "phone"
                                ],
                                "properties": {
                                    "phone": {
                                        "description": "Nomor WhatsApp aktif (format Indonesia)",
                                        "type": "string",
                                        "example": "081234567890"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "OTP Berhasil Dikirim",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "Kode OTP terkirim ke WhatsApp!"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Gagal Kirim OTP (Fonnte Error / Server Error)",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": false
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "Gagal kirim OTP"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/keranjang": {
            "get": {
                "tags": [
                    "Keranjang"
                ],
                "summary": "Lihat Keranjang Belanja",
                "operationId": "ab6ebf7ac21eeae1e6f5b70a36faf6e2",
                "responses": {
                    "200": {
                        "description": "List Keranjang"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            },
            "post": {
                "tags": [
                    "Keranjang"
                ],
                "summary": "Tambah Barang ke Keranjang",
                "operationId": "cd1ab4c04c0b6a50414e992cca451d18",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "produk_id",
                                    "jumlah"
                                ],
                                "properties": {
                                    "produk_id": {
                                        "type": "integer",
                                        "example": 1
                                    },
                                    "jumlah": {
                                        "type": "integer",
                                        "example": 2
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Berhasil masuk keranjang"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/api/orders": {
            "post": {
                "tags": [
                    "Order"
                ],
                "summary": "Checkout / Buat Pesanan",
                "operationId": "d690d6834318e9b064df441e854de8b9",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "alamat_pengiriman",
                                    "metode_pembayaran"
                                ],
                                "properties": {
                                    "alamat_pengiriman": {
                                        "type": "string",
                                        "example": "Jl. Mawar No 10"
                                    },
                                    "metode_pembayaran": {
                                        "type": "string",
                                        "example": "transfer_bank"
                                    },
                                    "catatan": {
                                        "type": "string",
                                        "example": "Tolong packing kayu"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Order Berhasil Dibuat"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/api/produk": {
            "post": {
                "tags": [
                    "Produk"
                ],
                "summary": "Upload Produk Baru (Hanya Seller)",
                "operationId": "90c4e4c017566a5c5afcae3f0490127b",
                "requestBody": {
                    "required": true,
                    "content": {
                        "multipart/form-data": {
                            "schema": {
                                "required": [
                                    "nama_barang",
                                    "harga_barang",
                                    "stok_barang",
                                    "deskripsi",
                                    "foto_barang[]"
                                ],
                                "properties": {
                                    "nama_barang": {
                                        "type": "string",
                                        "example": "Laptop Asus"
                                    },
                                    "harga_barang": {
                                        "type": "integer",
                                        "example": 5000000
                                    },
                                    "stok_barang": {
                                        "type": "integer",
                                        "example": 10
                                    },
                                    "deskripsi": {
                                        "type": "string",
                                        "example": "Produk akan diklasifikasikan otomatis oleh Decision Tree"
                                    },
                                    "foto_barang[]": {
                                        "type": "array",
                                        "items": {
                                            "type": "string",
                                            "format": "binary"
                                        }
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Produk Berhasil Dibuat"
                    },
                    "403": {
                        "description": "Forbidden (Bukan Seller)"
                    },
                    "422": {
                        "description": "Error Validasi"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        }
    },
    "components": {
        "securitySchemes": {
            "bearerAuth": {
                "type": "http",
                "description": "Masukkan Token Sanctum di sini",
                "bearerFormat": "JWT",
                "scheme": "bearer"
            }
        }
    },
    "tags": [
        {
            "name": "Auth",
            "description": "Auth"
        },
        {
            "name": "Otentikasi",
            "description": "Otentikasi"
        },
        {
            "name": "Keranjang",
            "description": "Keranjang"
        },
        {
            "name": "Order",
            "description": "Order"
        },
        {
            "name": "Produk",
            "description": "Produk"
        }
    ]
}